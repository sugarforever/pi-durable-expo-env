{
  "name": "pi-expo-filesystem",
  "version": "0.1.0",
  "description": "Expo workspace filesystem adapter for Pi Durable without Node.js or shell execution",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:portable": "node scripts/check-portable.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:portable",
    "prepack": "npm run build",
    "example:prepare": "npm pack --pack-destination examples/expo"
  },
  "peerDependencies": {
    "@earendil-works/pi-durable": "1.3.x",
    "expo-file-system": "58.x"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "expo": "58.0.15",
    "expo-file-system": "~58.0.9",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-durable",
    "expo",
    "react-native",
    "filesystem",
    "agent",
    "ios",
    "android"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
